# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string (Neon / Supabase / Vercel Postgres).
# Neon: copy the "Pooled connection" string from your project dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used when staff share portal links).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# WhatsApp Cloud API — set both to enable live reminder sending (optional).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
