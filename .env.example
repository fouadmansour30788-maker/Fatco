# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string (Neon / Supabase / Vercel Postgres).
# Neon: copy the "Pooled connection" string from your project dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used when staff share portal links).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# WhatsApp Cloud API — set both to enable live reminder + chatbot sending (optional).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""

# Required for the support chatbot (customer portal + WhatsApp) to respond at all.
# ANTHROPIC_API_KEY=""

# WhatsApp inbound chatbot webhook (app/api/whatsapp/webhook) — only needed once
# a Meta WhatsApp Business app exists. WHATSAPP_VERIFY_TOKEN is any string you
# pick and enter into Meta's webhook config; WHATSAPP_APP_SECRET comes from the
# Meta App dashboard and is used to verify inbound requests are really from Meta.
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
